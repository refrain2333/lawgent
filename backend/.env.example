# ============================================================
# LawGent 后端环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 请勿把填好真实密钥的 .env 提交到仓库。
# 各文件的作用与获取方式见仓库根目录 DEPENDENCIES.md
# ============================================================

# ---------- 服务 ----------
DEBUG=True
HOST=127.0.0.1
PORT=5006

# ---------- 安全 ----------
# JWT 签名密钥。生产部署（DEBUG=False）时必须改成随机值，否则启动会报错。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-secret
# 允许跨域访问的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库（PostgreSQL + pgvector）----------
# 与 research/lawgent-db/docker-compose.yml 的默认映射保持一致
DATABASE_URL=postgresql+asyncpg://LawGent:LawGent@localhost:54321/lawgent

# ---------- 数据路径（相对仓库根目录）----------
# 指向预处理好的向量 / 案例 / 知识图谱数据目录
DATA_VECTORS_PATH=data/processed/vectors
DATA_CRIMINAL_PATH=data/processed/criminal
DATA_KG_PATH=data/processed/knowledge_graph
ARTICLES_VECTORS_FILE=criminal_articles_vectors_finetuned.pkl
CASES_VECTORS_FILE=criminal_cases_vectors_finetuned.pkl

# ---------- LLM（默认 DeepSeek，OpenAI 兼容接口）----------
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 本地模型（Lawformer，路径相对 backend/ 目录）----------
# 指向 Lawformer 基础模型目录与微调权重文件
LOCAL_MODEL_PATH=../models/lawformer
FINETUNED_MODEL_PATH=../models/lawformer_backbone_only.pt
MODEL_OFFLINE_MODE=True
HF_HOME=../models/huggingface

# ---------- 日志 ----------
# 默认不保存 AI 输入/输出正文，避免将案件细节写入本地日志。受控调试时可显式改为 True。
LOG_AI_CONTENT=False

# ---------- 其他 ----------
EMBEDDING_DIM=768
CACHE_SIZE_LIMIT=1000

